# Development defaults to http://127.0.0.1:4173 and the local JSON prototype.
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
# Supabase project URL and server-only secret key; never expose or commit them.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Set a random 32+ character secret and HTTPS APP_ORIGIN for production.
# SESSION_SECRET=
# TRUST_PROXY=1
# LOCAL_DATA_FILE=.data/nusa.json
# Initial application account, used only by npm run db:seed:
# SEED_CORPORATE_ID=NUSA-YOURCOMPANY
# SEED_USER_ID=administrator
# SEED_NAME=Administrator
# SEED_EMAIL=administrator@yourcompany.example
# SEED_PASSWORD=
