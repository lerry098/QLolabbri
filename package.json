{
  "name": "nusa-corporate",
  "version": "2.0.0",
  "private": true,
  "description": "Independent corporate application preserving the local visual reference.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "db:check": "tsx server/check-supabase.ts",
    "db:seed": "tsx server/seed.ts",
    "format": "prettier --write src server shared tests *.ts *.json index.html README.md",
    "preview:legacy": "node server.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.90.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
